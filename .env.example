DATABASE_URL=postgres://spend:local-only@localhost:5432/spend
PORT=3001
HOST=127.0.0.1
# Safe default: synthetic fixture execution only.
ENABLE_FIXTURE_ADAPTER=true
ENABLE_LIVE_EXECUTION=false
# Test-cluster model simulation never calls OpenAI.
ENABLE_LOCALNET_MODEL=false
ENABLE_DEVNET_DEMO_MODEL=false
# Live OpenAI execution still requires explicit cost authorization.
# Keep live execution disabled until explicitly authorized.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_PROGRAM_ID=
# AGENT_PUBLIC_KEY=
# AGENT_WALLET_PATH=.local/agent.wallet.json
# OWNER_TOKEN=
# OWNER_WALLET_PATH=.local/owner.wallet.json
# REFERENCE_SERVICE_URL=http://127.0.0.1:3002
# REFERENCE_MINT=
# REFERENCE_RECIPIENT=
# REFERENCE_PORT=3002
