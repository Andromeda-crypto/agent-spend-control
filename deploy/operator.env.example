# Private configuration template. Copy to ignored deploy/operator.env, mode 600.
# No billable API execution. Never set OPENAI_API_KEY here.
DATABASE_PASSWORD=
# URL-encode the password; database is the internal Compose hostname.
DATABASE_URL=
REFERENCE_MINT=
REFERENCE_RECIPIENT=
AGENT_PUBLIC_KEY=
# Existing private signer paths outside checkout; readable by container uid 1000.
OWNER_WALLET_FILE=
AGENT_WALLET_FILE=
